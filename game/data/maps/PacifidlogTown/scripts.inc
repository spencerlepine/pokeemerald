PacifidlogTown_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PacifidlogTown_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, PacifidlogTown_OnResume
	.byte 0

PacifidlogTown_OnTransition:
	setflag FLAG_VISITED_PACIFIDLOG_TOWN
	end

PacifidlogTown_OnResume:
	setstepcallback STEP_CB_PACIFIDLOG_BRIDGE
	end

PacifidlogTown_EventScript_NinjaBoy::
	msgbox PacifidlogTown_Text_NeatHousesOnWater, MSGBOX_NPC
	end

PacifidlogTown_EventScript_Girl::
	msgbox PacifidlogTown_Text_FastRunningCurrent, MSGBOX_NPC
	end

PacifidlogTown_EventScript_Fisherman::
	msgbox PacifidlogTown_Text_SkyPillarTooScary, MSGBOX_NPC
	end

PacifidlogTown_EventScript_TownSign::
	msgbox PacifidlogTown_Text_TownSign, MSGBOX_SIGN
	end

PacifidlogTown_Text_FastRunningCurrent:
	.string "The sea around TIPOCA CITY has\n"
	.string "a fast-running tide.\p"
	.string "If you decide to SURF, you could end\n"
	.string "up swept away somewhere else.$"

PacifidlogTown_Text_NeatHousesOnWater:
	.string "See, isn't it neat?\n"
	.string "These houses stand on stilts over\l"
	.string "the sea!\p"
	.string "I was born here!$"

PacifidlogTown_Text_SkyPillarTooScary:
	.string "The ASTEROID SPIRE?\p"
	.string "…Oh, you must mean that tall, tall\n"
	.string "rock out among the asteroids.\p"
	.string "If you asked me, I wouldn't climb it.\n"
	.string "It's too scary to get up that high.\p"
	.string "Life at sea level in TIPOCA CITY,\n"
	.string "that suits me fine.$"

PacifidlogTown_Text_TownSign:
	.string "TIPOCA CITY\p"
	.string "“Where the rain never stops, and\n"
	.string "the sea never sleeps.”$"

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
PacifidlogTown_EventScript_SwKaminoanAide::
	lock
	faceplayer
	msgbox PacifidlogTown_Text_SwKaminoanAide_1, MSGBOX_DEFAULT
	release
	end

PacifidlogTown_EventScript_SwCloneCadet1::
	lock
	faceplayer
	msgbox PacifidlogTown_Text_SwCloneCadet1_1, MSGBOX_DEFAULT
	release
	end

PacifidlogTown_EventScript_SwCloneCadet2::
	lock
	faceplayer
	msgbox PacifidlogTown_Text_SwCloneCadet2_1, MSGBOX_DEFAULT
	release
	end

PacifidlogTown_EventScript_SwCloningHallSign2::
	msgbox PacifidlogTown_Text_SwCloningHallSign2_1, MSGBOX_SIGN
	end

PacifidlogTown_EventScript_SwHangarSignRebelTransport3::
	msgbox PacifidlogTown_Text_SwHangarSignRebelTransport3_1, MSGBOX_SIGN
	end

PacifidlogTown_Text_SwKaminoanAide_1:
	.string "“Welcome to Tipoca City. The Prime\n"
	.string "Minister asks that visitors keep to the\p"
	.string "walkways. The storms here do not\n"
	.string "forgive.”$"

PacifidlogTown_Text_SwCloneCadet1_1:
	.string "“Cadet drills start at dawn and end\n"
	.string "when the storm does. We train\p"
	.string "companions like we train ourselves:\n"
	.string "hard.”$"

PacifidlogTown_Text_SwCloneCadet2_1:
	.string "“Kamino has not built an army in years.\n"
	.string "We are the last class. Nobody tells us\p"
	.string "what for.”$"

PacifidlogTown_Text_SwCloningHallSign2_1:
	.string "TIPOCA CITY CLONING HALL\n"
	.string "Authorized visitors only.$"

PacifidlogTown_Text_SwHangarSignRebelTransport3_1:
	.string "LANDING PLATFORM\n"
	.string "Rebel transport flights. Ask the\n"
	.string "crew chief inside.$"

@ world_port end
