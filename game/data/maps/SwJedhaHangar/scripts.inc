

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwJedhaHangar_MapScripts::
	.byte 0

SwJedhaHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwJedhaHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwJedhaHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwJedhaHangar_EventScript_SwPilot_Fly1
SwJedhaHangar_EventScript_SwPilot_Next1:
	goto_if_unset FLAG_BADGE06_GET, SwJedhaHangar_EventScript_SwPilot_Next2
	msgbox SwJedhaHangar_Text_SwPilot_12, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwJedhaHangar_EventScript_SwPilot_Fly2
SwJedhaHangar_EventScript_SwPilot_Next2:
	goto_if_unset FLAG_RECEIVED_RED_OR_BLUE_ORB, SwJedhaHangar_EventScript_SwPilot_Next3
	msgbox SwJedhaHangar_Text_SwPilot_13, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwJedhaHangar_EventScript_SwPilot_Fly3
SwJedhaHangar_EventScript_SwPilot_Next3:
	msgbox SwJedhaHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwJedhaHangar_EventScript_SwPilot_Fly1:
	msgbox SwJedhaHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_LILYCOVE_CITY_HARBOR, 0
	waitstate
	release
	end

SwJedhaHangar_EventScript_SwPilot_Fly2:
	msgbox SwJedhaHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_SW_ROUTE_123_LANDING, 0
	waitstate
	release
	end

SwJedhaHangar_EventScript_SwPilot_Fly3:
	msgbox SwJedhaHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_MT_CHIMNEY_CABLE_CAR_STATION, 0
	waitstate
	release
	end

SwJedhaHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwJedhaHangar_Text_SwPilot_11:
	.string "PILOT: BESPIN?$"

SwJedhaHangar_Text_SwPilot_12:
	.string "PILOT: ENDOR?$"

SwJedhaHangar_Text_SwPilot_13:
	.string "PILOT: MUSTAFAR?$"

SwJedhaHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwJedhaHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
