

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwTythonHangar_MapScripts::
	.byte 0

SwTythonHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwTythonHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwTythonHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwTythonHangar_EventScript_SwPilot_Fly1
SwTythonHangar_EventScript_SwPilot_Next1:
	msgbox SwTythonHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwTythonHangar_EventScript_SwPilot_Fly1:
	msgbox SwTythonHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_LILYCOVE_CITY_HARBOR, 0
	waitstate
	release
	end

SwTythonHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwTythonHangar_Text_SwPilot_11:
	.string "PILOT: BESPIN?$"

SwTythonHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwTythonHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
