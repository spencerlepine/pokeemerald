

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwDagobahHangar_MapScripts::
	.byte 0

SwDagobahHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwDagobahHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwDagobahHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwDagobahHangar_EventScript_SwPilot_Fly1
SwDagobahHangar_EventScript_SwPilot_Next1:
	goto_if_unset FLAG_WALLACE_GOES_TO_SKY_PILLAR, SwDagobahHangar_EventScript_SwPilot_Next2
	msgbox SwDagobahHangar_Text_SwPilot_12, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwDagobahHangar_EventScript_SwPilot_Fly2
SwDagobahHangar_EventScript_SwPilot_Next2:
	goto_if_unset FLAG_BADGE08_GET, SwDagobahHangar_EventScript_SwPilot_Next3
	msgbox SwDagobahHangar_Text_SwPilot_13, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwDagobahHangar_EventScript_SwPilot_Fly3
SwDagobahHangar_EventScript_SwPilot_Next3:
	msgbox SwDagobahHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwDagobahHangar_EventScript_SwPilot_Fly1:
	msgbox SwDagobahHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_MOSSDEEP_CITY_SPACE_CENTER_1F, 0
	waitstate
	release
	end

SwDagobahHangar_EventScript_SwPilot_Fly2:
	msgbox SwDagobahHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_SW_ASTEROID_SPIRE_HANGAR, 0
	waitstate
	release
	end

SwDagobahHangar_EventScript_SwPilot_Fly3:
	msgbox SwDagobahHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_SW_ILUM_HANGAR, 0
	waitstate
	release
	end

SwDagobahHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwDagobahHangar_Text_SwPilot_11:
	.string "PILOT: YAVIN 4?$"

SwDagobahHangar_Text_SwPilot_12:
	.string "PILOT: ASTEROID FIELD?$"

SwDagobahHangar_Text_SwPilot_13:
	.string "PILOT: ILUM?$"

SwDagobahHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwDagobahHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
