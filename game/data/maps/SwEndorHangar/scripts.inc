

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwEndorHangar_MapScripts::
	.byte 0

SwEndorHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwEndorHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	goto_if_unset FLAG_RECEIVED_DEVON_SCOPE, SwEndorHangar_EventScript_SwPilot_Next1
	msgbox SwEndorHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwEndorHangar_EventScript_SwPilot_Fly1
SwEndorHangar_EventScript_SwPilot_Next1:
	msgbox SwEndorHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwEndorHangar_EventScript_SwPilot_Fly1:
	msgbox SwEndorHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_LILYCOVE_CITY_HARBOR, 0
	waitstate
	release
	end

SwEndorHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwEndorHangar_Text_SwPilot_11:
	.string "PILOT: BESPIN?$"

SwEndorHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwEndorHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
