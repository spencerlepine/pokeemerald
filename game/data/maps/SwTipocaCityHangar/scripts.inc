SwTipocaCityHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwTipocaCityHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwTipocaCityHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwTipocaCityHangar_EventScript_SwPilot_Fly1
SwTipocaCityHangar_EventScript_SwPilot_Next1:
	msgbox SwTipocaCityHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwTipocaCityHangar_EventScript_SwPilot_Fly1:
	msgbox SwTipocaCityHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_MOSSDEEP_CITY_SPACE_CENTER_1F, 0
	waitstate
	release
	end

