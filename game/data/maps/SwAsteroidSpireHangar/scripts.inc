

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwAsteroidSpireHangar_MapScripts::
	.byte 0

SwAsteroidSpireHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwAsteroidSpireHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwAsteroidSpireHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwAsteroidSpireHangar_EventScript_SwPilot_Fly1
SwAsteroidSpireHangar_EventScript_SwPilot_Next1:
	msgbox SwAsteroidSpireHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwAsteroidSpireHangar_EventScript_SwPilot_Fly1:
	msgbox SwAsteroidSpireHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_SW_DAGOBAH_HANGAR, 0
	waitstate
	release
	end

SwAsteroidSpireHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwAsteroidSpireHangar_Text_SwPilot_11:
	.string "PILOT: DAGOBAH?$"

SwAsteroidSpireHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwAsteroidSpireHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
