

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwHangarTatooineSullust_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SwHangarTatooineSullust_OnTransition
	.byte 0

SwHangarTatooineSullust_OnTransition:
	setvar VAR_TEMP_1, 1
	getplayerxy VAR_TEMP_2, VAR_TEMP_3
	goto_if_ne VAR_TEMP_2, 17, SwHangarTatooineSullust_OnTransitionEnd
	goto_if_ne VAR_TEMP_3, 9, SwHangarTatooineSullust_OnTransitionEnd
	setvar VAR_TEMP_1, 2
SwHangarTatooineSullust_OnTransitionEnd:
	end


SwHangarTatooineSullust_EventScript_SwPilot::
	lock
	faceplayer
	goto_if_eq VAR_TEMP_1, 0, SwHangarTatooineSullust_EventScript_SwPilot_Flown
	goto_if_eq VAR_TEMP_1, 2, SwHangarTatooineSullust_EventScript_SwPilot_Back
	goto_if_unset FLAG_BADGE03_GET, SwHangarTatooineSullust_EventScript_SwPilot_Locked
	msgbox SwHangarTatooineSullust_Text_SwPilot_4, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHangarTatooineSullust_EventScript_SwPilot_Fly
	release
	end

SwHangarTatooineSullust_EventScript_SwPilot_Back:
	msgbox SwHangarTatooineSullust_Text_SwPilot_5, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHangarTatooineSullust_EventScript_SwPilot_Fly
	release
	end

SwHangarTatooineSullust_EventScript_SwPilot_Fly:
	msgbox SwHangarTatooineSullust_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	fadescreen FADE_TO_BLACK
	waitse
	setvar VAR_TEMP_1, 0
	fadescreen FADE_FROM_BLACK
	release
	end

SwHangarTatooineSullust_EventScript_SwPilot_Flown:
	msgbox SwHangarTatooineSullust_Text_SwPilot_1, MSGBOX_DEFAULT
	release
	end

SwHangarTatooineSullust_EventScript_SwPilot_Locked:
	msgbox SwHangarTatooineSullust_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwHangarTatooineSullust_EventScript_SwCabinHatch1::
	lockall
	msgbox SwHangarTatooineSullust_Text_SwCabinHatch_1, MSGBOX_DEFAULT
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, SwHangarTatooineSullust_EventScript_SwCabinHatch1_Back
	waitmovement 0
	releaseall
	end

SwHangarTatooineSullust_EventScript_SwCabinHatch1_Back:
	walk_left
	step_end

SwHangarTatooineSullust_EventScript_SwCabinHatch2::
	lockall
	msgbox SwHangarTatooineSullust_Text_SwCabinHatch_1, MSGBOX_DEFAULT
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, SwHangarTatooineSullust_EventScript_SwCabinHatch2_Back
	waitmovement 0
	releaseall
	end

SwHangarTatooineSullust_EventScript_SwCabinHatch2_Back:
	walk_up
	step_end

