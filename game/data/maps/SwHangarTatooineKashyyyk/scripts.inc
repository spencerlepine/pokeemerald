

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwHangarTatooineKashyyyk_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SwHangarTatooineKashyyyk_OnTransition
	.byte 0

SwHangarTatooineKashyyyk_OnTransition:
	setvar VAR_TEMP_1, 1
	getplayerxy VAR_TEMP_2, VAR_TEMP_3
	goto_if_ne VAR_TEMP_2, 9, SwHangarTatooineKashyyyk_OnTransitionEnd
	goto_if_ne VAR_TEMP_3, 11, SwHangarTatooineKashyyyk_OnTransitionEnd
	setvar VAR_TEMP_1, 2
SwHangarTatooineKashyyyk_OnTransitionEnd:
	end


SwHangarTatooineKashyyyk_EventScript_SwPilot::
	lock
	faceplayer
	goto_if_eq VAR_TEMP_1, 0, SwHangarTatooineKashyyyk_EventScript_SwPilot_Flown
	goto_if_eq VAR_TEMP_1, 2, SwHangarTatooineKashyyyk_EventScript_SwPilot_Back
	goto_if_unset FLAG_RETURNED_DEVON_GOODS, SwHangarTatooineKashyyyk_EventScript_SwPilot_Locked
	msgbox SwHangarTatooineKashyyyk_Text_SwPilot_4, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHangarTatooineKashyyyk_EventScript_SwPilot_Fly
	release
	end

SwHangarTatooineKashyyyk_EventScript_SwPilot_Back:
	msgbox SwHangarTatooineKashyyyk_Text_SwPilot_5, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHangarTatooineKashyyyk_EventScript_SwPilot_Fly
	release
	end

SwHangarTatooineKashyyyk_EventScript_SwPilot_Fly:
	msgbox SwHangarTatooineKashyyyk_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	fadescreen FADE_TO_BLACK
	waitse
	setvar VAR_TEMP_1, 0
	fadescreen FADE_FROM_BLACK
	release
	end

SwHangarTatooineKashyyyk_EventScript_SwPilot_Flown:
	msgbox SwHangarTatooineKashyyyk_Text_SwPilot_1, MSGBOX_DEFAULT
	release
	end

SwHangarTatooineKashyyyk_EventScript_SwPilot_Locked:
	msgbox SwHangarTatooineKashyyyk_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

