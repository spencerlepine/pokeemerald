

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwFeluciaHangar_MapScripts::
	.byte 0

SwFeluciaHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwFeluciaHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwFeluciaHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwFeluciaHangar_EventScript_SwPilot_Fly1
SwFeluciaHangar_EventScript_SwPilot_Next1:
	msgbox SwFeluciaHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwFeluciaHangar_EventScript_SwPilot_Fly1:
	msgbox SwFeluciaHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_ROUTE121_SAFARI_ZONE_ENTRANCE, 0
	waitstate
	release
	end

SwFeluciaHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwFeluciaHangar_Text_SwPilot_11:
	.string "PILOT: ENDOR?$"

SwFeluciaHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwFeluciaHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
