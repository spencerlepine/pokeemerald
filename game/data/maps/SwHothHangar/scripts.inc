

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwHothHangar_MapScripts::
	.byte 0

SwHothHangar_EventScript_SwPilot::
	lock
	faceplayer
	msgbox SwHothHangar_Text_SwPilot_1, MSGBOX_DEFAULT
	msgbox SwHothHangar_Text_SwPilot_11, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHothHangar_EventScript_SwPilot_Fly1
SwHothHangar_EventScript_SwPilot_Next1:
	msgbox SwHothHangar_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwHothHangar_EventScript_SwPilot_Fly1:
	msgbox SwHothHangar_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	waitse
	warp MAP_MOSSDEEP_CITY_SPACE_CENTER_1F, 0
	waitstate
	release
	end

SwHothHangar_Text_SwPilot_1:
	.string "PILOT: Strap in. Where are we headed?$"

SwHothHangar_Text_SwPilot_11:
	.string "PILOT: YAVIN 4?$"

SwHothHangar_Text_SwPilot_2:
	.string "PILOT: No clearance for anywhere else\n"
	.string "yet. I will be right here.$"

SwHothHangar_Text_SwPilot_3:
	.string "PILOT: Punch it!$"

@ world_port end
