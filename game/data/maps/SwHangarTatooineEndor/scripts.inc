

@ world_port begin (generated by wiki/tools/world_port, do not edit inside)
SwHangarTatooineEndor_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SwHangarTatooineEndor_OnTransition
	.byte 0

SwHangarTatooineEndor_OnTransition:
	setvar VAR_TEMP_1, 1
	getplayerxy VAR_TEMP_2, VAR_TEMP_3
	goto_if_ne VAR_TEMP_2, 17, SwHangarTatooineEndor_OnTransitionEnd
	goto_if_ne VAR_TEMP_3, 9, SwHangarTatooineEndor_OnTransitionEnd
	setvar VAR_TEMP_1, 2
SwHangarTatooineEndor_OnTransitionEnd:
	end


SwHangarTatooineEndor_EventScript_SwPilot::
	lock
	faceplayer
	goto_if_eq VAR_TEMP_1, 0, SwHangarTatooineEndor_EventScript_SwPilot_Flown
	goto_if_eq VAR_TEMP_1, 2, SwHangarTatooineEndor_EventScript_SwPilot_Back
	goto_if_unset FLAG_BADGE05_GET, SwHangarTatooineEndor_EventScript_SwPilot_Locked
	msgbox SwHangarTatooineEndor_Text_SwPilot_4, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHangarTatooineEndor_EventScript_SwPilot_Fly
	release
	end

SwHangarTatooineEndor_EventScript_SwPilot_Back:
	msgbox SwHangarTatooineEndor_Text_SwPilot_5, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SwHangarTatooineEndor_EventScript_SwPilot_Fly
	release
	end

SwHangarTatooineEndor_EventScript_SwPilot_Fly:
	msgbox SwHangarTatooineEndor_Text_SwPilot_3, MSGBOX_DEFAULT
	closemessage
	playse SE_HYPERSPACE_JUMP
	fadescreen FADE_TO_BLACK
	waitse
	setvar VAR_TEMP_1, 0
	fadescreen FADE_FROM_BLACK
	release
	end

SwHangarTatooineEndor_EventScript_SwPilot_Flown:
	msgbox SwHangarTatooineEndor_Text_SwPilot_1, MSGBOX_DEFAULT
	release
	end

SwHangarTatooineEndor_EventScript_SwPilot_Locked:
	msgbox SwHangarTatooineEndor_Text_SwPilot_2, MSGBOX_DEFAULT
	release
	end

SwHangarTatooineEndor_EventScript_SwCabinHatch1::
	lockall
	msgbox SwHangarTatooineEndor_Text_SwCabinHatch_1, MSGBOX_DEFAULT
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, SwHangarTatooineEndor_EventScript_SwCabinHatch1_Back
	waitmovement 0
	releaseall
	end

SwHangarTatooineEndor_EventScript_SwCabinHatch1_Back:
	walk_left
	step_end

SwHangarTatooineEndor_EventScript_SwCabinHatch2::
	lockall
	msgbox SwHangarTatooineEndor_Text_SwCabinHatch_1, MSGBOX_DEFAULT
	closemessage
	applymovement OBJ_EVENT_ID_PLAYER, SwHangarTatooineEndor_EventScript_SwCabinHatch2_Back
	waitmovement 0
	releaseall
	end

SwHangarTatooineEndor_EventScript_SwCabinHatch2_Back:
	walk_up
	step_end

SwHangarTatooineEndor_Text_SwPilot_1:
	.string "PILOT: We are here. Off you go, the\n"
	.string "hatch is open.$"

SwHangarTatooineEndor_Text_SwPilot_2:
	.string "PILOT: No clearance for ENDOR yet. Come\n"
	.string "back when you have it.$"

SwHangarTatooineEndor_Text_SwPilot_3:
	.string "PILOT: Strap in. Punch it!$"

SwHangarTatooineEndor_Text_SwPilot_4:
	.string "PILOT: ENDOR?$"

SwHangarTatooineEndor_Text_SwPilot_5:
	.string "PILOT: Back to TATOOINE?$"

SwHangarTatooineEndor_Text_SwCabinHatch_1:
	.string "PILOT: Hold on! Talk to me before you go\n"
	.string "out that hatch.$"

@ world_port end
