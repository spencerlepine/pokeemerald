EverGrandeCity_Text_SwGateWarden_1:
	.string "“The Four Trials wait past this gate.\n"
	.string "Only those with every badge are let in.\p"
	.string "The cold is the first test.”$"

EverGrandeCity_Text_SwTempleAcolyte_1:
	.string "“The crystals sing when the wind drops.\n"
	.string "Listen, and you will hear which one is\p"
	.string "yours.”$"

EverGrandeCity_Text_SwPilgrim_1:
	.string "“I walked from the landing pad in a\n"
	.string "blizzard. The Bacta droids thawed me\p"
	.string "out. Worth it.”$"

EverGrandeCity_Text_SwCrystalHunter_1:
	.string "“The caves are full of kyber, and full\n"
	.string "of things that guard it. Bring a light,\p"
	.string "and bring friends.”$"

EverGrandeCity_Text_SwRebelPilot_1:
	.string "“I fly pilgrims in and frozen pilgrims\n"
	.string "out. Do not stay on the ice after dark.”$"

